<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockPlatform.Data</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 列公告/标题排序那套判据踩平过 9 个坑，却一直裸奔。2026-09-15 开放给测试钉住，
         这是把它抽成独立数据源类之前必须先立的保护。 -->
    <InternalsVisibleTo Include="StockPlatform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- 解析中证指数官网的 closeweight.xls（真 OLE2/BIFF）——读取需注册 CodePages（上面已引用） -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockPlatform.Logic\StockPlatform.Logic.csproj" />
    <!-- PDF 提取（PdfPig 取词 + 坐标聚类、pdftotext 兜底、OCR 兜底）。2026-09-11 从本项目
         拆出去：那几个类不认识"股票/报告期/指标"，是纯工具，留在这里会被业务代码渗透。
         PdfPig 的 PackageReference 跟着搬走了，这里只留一条项目引用。 -->
    <ProjectReference Include="..\StockPlatform.Pdf\StockPlatform.Pdf.csproj" />
  </ItemGroup>

</Project>
