<Window x:Class="StockPlatform.Analyzer.HolderPortfolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="股东持仓" Height="720" Width="1200" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Window.Background}"
        xmlns:local="clr-namespace:StockPlatform.Analyzer"
        Foreground="{DynamicResource Theme.Foreground}">
    <Window.Resources>
        <local:VisibilityToBoolConverter x:Key="VisibilityToBool" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" x:Name="SubtitleText" Foreground="{DynamicResource Theme.Foreground.Subtle}" TextWrapping="Wrap" Margin="0,0,0,4" />
        <Border Grid.Row="2" x:Name="NaturalPersonBanner" Visibility="Collapsed" Padding="8,4" Margin="0,0,0,6"
                Background="{DynamicResource Theme.Warn.Background}" BorderBrush="{DynamicResource Theme.Warn.Border}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Warn.Foreground}"
                       Text="⚠ 这是自然人股东，只能按姓名匹配——同名不等于同一个人，下面的票很可能分属不同的人。看股数量级、股本性质和持有时段自己判断。" />
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox x:Name="IncludeExitedCheck" Content="含已退出前十的股票" VerticalAlignment="Center"
                      Click="IncludeExitedCheck_Click" />
            <TextBlock x:Name="CountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Subtle}" />
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="PositionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" ClipboardCopyMode="IncludeHeader"
                  RowDetailsVisibilityMode="Collapsed" SelectionMode="Single"
                  AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}"
                  MouseDoubleClick="PositionsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="34" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 跟所在行的 DetailsVisibility 双向绑定：鼠标点和 UIAutomation 的 Toggle 都走得通 -->
                            <ToggleButton IsChecked="{Binding DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource VisibilityToBool}, Mode=TwoWay}" Width="22" Height="18" Padding="0" FontSize="11"
                                          ToolTip="展开/收起这只票的明细（按日期倒序）">
                                <ToggleButton.Style>
                                    <!-- 自带模板：主题里的 ToggleButton 模板不显示 Content，只剩一个空白方块 -->
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="+" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" BorderThickness="1" CornerRadius="2"
                                                            BorderBrush="{DynamicResource Theme.Control.Border}">
                                                        <ContentPresenter TextElement.FontWeight="Bold"
                                                                          TextElement.Foreground="{DynamicResource Theme.Foreground}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="−" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" />
                <DataGridTextColumn Header="最近在榜报告期" Binding="{Binding Period}" Width="115" />
                <DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="持股数量" Binding="{Binding Shares, StringFormat=N0}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="占比" Binding="{Binding Ratio, StringFormat={}{0:F2}%}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="股本性质" Binding="{Binding ShareType}" Width="110" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="*" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              ClipboardCopyMode="IncludeHeader" Margin="34,2,6,8" MaxHeight="320"
                              AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="95" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="85" />
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="75" />
                            <DataGridTextColumn Header="变动股数" Binding="{Binding Change}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="持股数量" Binding="{Binding Shares}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="占比" Binding="{Binding Ratio}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="均价" Binding="{Binding Price}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 明细表在 RowDetails 里拿不到确定宽度，* 会被压成几像素，所以给固定宽 -->
                            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="420" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</Window>
