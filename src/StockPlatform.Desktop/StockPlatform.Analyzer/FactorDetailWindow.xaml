<Window x:Class="StockPlatform.Analyzer.FactorDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="因子说明" Height="520" Width="620" MinHeight="300" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <!-- 用只读 TextBox 而不是 TextBlock：可以拖选、Ctrl+C 复制（构造公式经常要拷出去核对） -->
        <TextBox x:Name="BodyText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}"
                 Background="{DynamicResource Theme.Panel.Background.Soft}" Padding="8" FontSize="13"
                 IsInactiveSelectionHighlightEnabled="True" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="可拖选后 Ctrl+C 复制" Foreground="{DynamicResource Theme.Foreground.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="关闭" Width="80" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
