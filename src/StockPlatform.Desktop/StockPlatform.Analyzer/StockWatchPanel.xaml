<UserControl x:Class="StockPlatform.Analyzer.StockWatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             Foreground="{DynamicResource Theme.Foreground}">
    <!-- 单只票的观察项，嵌在【分析详情】窗口右上角（2026-09-14）。
         左边财务、右上事件、右下趋势——三样同屏，不用再开第二个窗口去对照。

         ⚠ 这里**只有事件叙述**，另外两块都是想过之后砍掉的：
         · 「个人观点」内容区 —— 全库 62 只票只有 1 只写了笔记，那块地方是白占的。
           点标题行的【分析笔记】就能读能写，读写本来就在同一个地方。
         · 「报过什么」（触发记录） —— 跟上面的事件**高度重复**。实测宁德 4 条触发全是
           "回购进展""碳酸锂变动"的另一种说法，唯一的增量信息只是"哪天报的警"。
           连同「标为已处理」整套一起删了（2026-09-14）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行跟左栏的标题行对齐，左右两边看着是一对 -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="观察项" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Accent.Deep}"
                       ToolTip="这只票身上发生了什么：回购买到哪一步、什么时候解禁多少、业绩预告、股东增减持、跌破均线。&#10;事项之间按日期倒序，同一件事内部按时间正序、缩进显示进展。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                           Foreground="{DynamicResource Theme.Foreground.Muted}" />
                <Button x:Name="NoteButton" Content="分析笔记" Padding="8,1" Click="Note_Click"
                        ToolTip="这只票的判断、疑点、下次要盯什么。存成 notes\{代码}.md，可直接用编辑器改、可进 git" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="EventsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="None"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}">
            <DataGrid.Columns>
                <!-- ⚠ 日期用**全格式**，不缩成 09-11（2026-09-14 想过又否掉）：
                     解禁是日程表，库里躺着 2030 年的解禁计划，去掉年份会被读成今年。
                     省那 45px 不值得冒这个险。 -->
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="82" />
                <DataGridTemplateColumn Header="事件" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Margin="{Binding Margin}" TextWrapping="Wrap"
                                       ToolTip="{Binding Tip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- 还没发生的（解禁）淡一点，跟已成事实的分开 -->
                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground.Muted}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 一条事件都没有时顶掉表格：说清是"库里没有"而不是"这票没事"——
             数据缺失和确实没动静是两回事。 -->
        <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="2,8,2,0" Foreground="{DynamicResource Theme.Foreground.Muted}" />
    </Grid>
</UserControl>
