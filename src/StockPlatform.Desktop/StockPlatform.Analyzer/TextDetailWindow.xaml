<Window x:Class="StockPlatform.Analyzer.TextDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="详情" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei">
    <!-- 长文本详情的通用窗口（2026-08-20 新增）——替代原来的 MessageBox.Show。
         MessageBox 的宽度和字体都改不了：条件详情和 ⓘ 条件说明动辄几十行、还带缩进对齐的表格，
         挤在系统对话框里既看不全也对不齐（用户 2026-08-20 反馈"太窄、字体小"）。
         这里用等宽字体 + 大窗口（开到屏幕九成，见 TextFitter.SizeToScreen）+ 打开时
         自动挑一个能装下不出滚动条的最大字号（TextFitter.Fit，用户 2026-08-20 要求）。 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <!-- 等宽字体是必须的：文本里有大量用空格和 ├└ 对齐的表格，非等宽会全部错位。
             Consolas 打头、中文回退到雅黑（中文全角正好是 Consolas 拉丁字符的两倍宽，能对齐），
             跟各页"运行日志"框的做法一致。

             **两列**：最长的一行也只有 90 来个半角宽，而全屏窗口横向能放 200 多个——单列的话
             右边一半是空的、内容却在纵向溢出。所以单列装不下时自动把条目分到第二列（见
             TextDetailWindow.LayoutBody），用户要求"不要出现滚动条"，横向那半屏不能白放着。
             内容不多时第二列是折叠的，不会无谓地把一段短文本劈成两半。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FCFCFC">
                <TextBox x:Name="BodyText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="15" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" IsInactiveSelectionHighlightEnabled="True"
                         ToolTip="可用鼠标拖选、Ctrl+C 复制，Ctrl+A 全选" />
            </Border>
            <Border x:Name="SecondBorder" Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1"
                    Background="#FCFCFC" Margin="8,0,0,0" Visibility="Collapsed">
                <TextBox x:Name="BodyText2" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="15" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" IsInactiveSelectionHighlightEnabled="True"
                         ToolTip="接着左边那列往下看" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="字号" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0" />
            <Button Content="&#8722;" Width="32" Click="SmallerFont_Click" ToolTip="缩小字号" />
            <Button Content="&#43;" Width="32" Margin="4,0,0,0" Click="LargerFont_Click" ToolTip="放大字号" />
            <Button Content="复制全部" Width="90" Margin="12,0,0,0" Click="CopyAll_Click" />
            <Button Content="关闭" Width="90" Margin="8,0,0,0" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
