<Window x:Class="StockPlatform.Analyzer.TradeLotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StockPlatform.Analyzer"
        Title="交易记录" Height="540" Width="820" MinHeight="360" MinWidth="620"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Foreground="{DynamicResource Theme.Foreground.Muted}" TextWrapping="Wrap"
                       Text="买入、卖出都可以录多笔（金字塔式建仓 / 分批止盈）。表格里双击即可修改；日期填 2026-08-11 这种格式，价格和股数都必须大于0。保存后，&quot;主动仓&quot;列表显示的是这些笔汇总出来的总股数和加权平均价。&#10;「原因」建议每笔都填——它是**事后没法补的**：过几个月就想不起来那笔到底是到点止盈走的、还是看着不对提前跑的，而这两者正是判断「纪律有没有用」的关键。留空也能存。" />

            <!-- 费率设置——各家券商佣金不一样，做成可填的。全程序共用一份（存 data\trade-fees.json），
                 在这里改完立刻生效并落盘，下面的费用/汇总跟着重算。单位统一用"万分之"（券商就是这么
                 报价的），最低佣金按元。 -->
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="费率：" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Muted}" />
                <TextBlock Text="佣金 万分之" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBox x:Name="CommissionBox" Width="46" Margin="2,0" LostFocus="FeeInput_LostFocus"
                         ToolTip="佣金费率，单位万分之（填 1.2 就是万分之1.2 = 0.012%）。买入、卖出都收。" />
                <TextBlock Text="，最低" VerticalAlignment="Center" />
                <TextBox x:Name="MinCommissionBox" Width="40" Margin="2,0" LostFocus="FeeInput_LostFocus"
                         ToolTip="单笔最低佣金（元）——按费率算出来不足这个数就按这个数收。不设下限填0。" />
                <TextBlock Text="元" VerticalAlignment="Center" />
                <TextBlock Text="｜过户费 万分之" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox x:Name="TransferBox" Width="46" Margin="2,0" LostFocus="FeeInput_LostFocus"
                         ToolTip="过户费费率，单位万分之。买入、卖出都收。" />
                <TextBlock Text="｜印花税 万分之" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox x:Name="StampDutyBox" Width="46" Margin="2,0" LostFocus="FeeInput_LostFocus"
                         ToolTip="印花税费率，单位万分之。只有卖出才收。" />
                <TextBlock Text="（只卖出收）" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Muted}" />
                <TextBlock Text="——改完点一下别处即生效，全局保存" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Muted}" Margin="10,0,0,0"
                           ToolTip="费率是账户级设置，全程序共用一份：在这里改了，所有股票的含费盈亏和止亏价都按新费率重算。" />
            </WrapPanel>

            <!-- 底仓专用的一行（2026-08-20 新增）：目标年化股息 + 由它倒推的目标股数。
                 主动仓打开这个窗口时整行是折叠的——那边没有"目标年化股息"这个概念，它的仓位
                 走凯利、按胜率赔率算，不是按现金流倒推的。
                 为什么挪到这里：这个数原来是【底仓】页表格里一列，但设目标和录买入笔数本来就是
                 同一件事的两半（"我打算每年收多少" ↔ "所以要买到多少股"），放在一起填更顺，
                 表格那边也少两列（用户 2026-08-20 要求）。 -->
            <StackPanel x:Name="CorePositionPlanPanel" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="目标年化股息：" VerticalAlignment="Center" />
                <TextBox x:Name="TargetDividendBox" Width="80" VerticalAlignment="Center"
                         LostFocus="TargetDividend_LostFocus"
                         ToolTip="想每年从这只票收多少分红（元，税前）。底仓的仓位按现金流倒推，不走凯利" />
                <TextBlock Text="元" VerticalAlignment="Center" Margin="2,0,0,0" />
                <TextBlock x:Name="TargetSharesText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Theme.Accent.Soft}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="LotsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- 方向/原因两列都用 DataGridTemplateColumn，不用 DataGridComboBoxColumn——
                     后者的 ElementStyle/EditingElementStyle 是一个**显式** Style（要么 DataGrid 内建的
                     默认值，要么像原因列那样自己写一个来设行级 ItemsSource），而 WPF 里显式 Style 会
                     整个顶掉隐式样式：深色主题的 ComboBox 模板（Controls.Dark.xaml）就此失效，下拉弹出
                     退回系统默认模板的**白底**，文字前景却还是从窗口继承来的浅灰——白底浅灰字，选项
                     基本看不清（2026-09-15 修）。用 TemplateColumn 放一个普通 ComboBox 就没这问题：
                     它是可视树里的正常控件，隐式样式照常套上。
                     注意别改成给 Style 加 BasedOn="{StaticResource {x:Type ComboBox}}"——Controls.Dark.xaml
                     是运行时才合并进去的，浅色主题下这个资源根本不存在，XAML 解析会直接抛异常。 -->
                <DataGridTemplateColumn Header="方向" Width="80" SortMemberPath="SideText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static local:TradeLotEditRow.SideOptions}"
                                      SelectedItem="{Binding SideText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="日期" Width="110"
                                    Binding="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="价格" Width="90"
                                    Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="股数" Width="100"
                                    Binding="{Binding SharesText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="金额" Width="110" IsReadOnly="True"
                                    Binding="{Binding AmountText}" />
                <DataGridTextColumn Header="费用" Width="120" IsReadOnly="True"
                                    Binding="{Binding FeeText}" />
                <!-- 原因：选项跟着"方向"变（买入 4 个 / 卖出 7 个），所以 ItemsSource 绑到行上
                     而不是用 x:Static 绑一份静态列表。留空表示"未填"，不强制。
                     为什么是 TemplateColumn 而不是 ComboBoxColumn，见上面「方向」列的说明。 -->
                <DataGridTemplateColumn Header="原因" Width="170" SortMemberPath="ReasonLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ReasonOptions}"
                                      SelectedItem="{Binding ReasonLabel, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="备注" Width="*"
                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="＋买入" Width="80" Click="AddBuy_Click"
                    ToolTip="加一笔买入（默认按上一笔的价格带出来，改成实际成交价即可）" />
            <Button Content="＋卖出" Width="80" Margin="8,0,0,0" Click="AddSell_Click"
                    ToolTip="加一笔卖出（默认股数=当前剩余持仓，分批卖就改小）" />
            <Button Content="删除选中" Width="80" Margin="8,0,0,0" Click="DeleteSelected_Click" />
        </StackPanel>

        <Border Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="530"
                       TextAlignment="Right" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" IsDefault="True" Click="Save_Click" />
            <Button Content="取消" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
