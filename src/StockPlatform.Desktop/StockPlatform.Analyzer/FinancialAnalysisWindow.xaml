<Window x:Class="StockPlatform.Analyzer.FinancialAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="财务分析" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei">
    <!-- 财务分析（2026-08-27 新增）——把 52 个财务科目翻译成人能一眼看懂的判断。
         不是再列一张比率表：每行都带"这意味着什么"，每节末尾给结论，最后汇总异常项。
         计算全在 FinancialAnalyzer 里（纯计算、不联网），这里只负责画。

         布局：左边表格（占大头，信息在这里）、右边趋势小图（回答"在变好还是变坏"）。
         窗口开到屏幕九成大，见 TextFitter.SizeToScreen。 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行同时承载"总体判断"（2026-08-27 用户要求合并），所以要允许换行 -->
        <TextBlock Grid.Row="0" x:Name="HeaderText" FontSize="17" Margin="0,0,0,6" TextWrapping="Wrap" />

        <!-- 第 1 行同时容纳两块（都是默认隐藏、按需显示）：
             ① 出错提示（没有财务数据时）——正常情况下总体判断已并进标题行，这块不出现
             ② 需要留意的项 —— 2026-08-27 从窗口底部挪到这里。阅读顺序应该是
                "标题给结论 → 先知道有哪几项要留意 → 再往下看详细时就会盯着这几项"，
                放在底部等于看完全部细节才告诉你重点在哪，顺序是反的。 -->
        <StackPanel Grid.Row="1">
            <Border x:Name="HeadlineBorder" Background="#FFF8E7" BorderBrush="#E8D8A8"
                    BorderThickness="1" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" FontSize="14" />
            </Border>

            <Border x:Name="AlertBorder" Background="#FDF2F2" BorderBrush="#F0C8C8"
                    BorderThickness="1" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="AlertTitle" FontWeight="Bold" Foreground="#B02020" Margin="0,0,0,3" />
                    <!-- 异常项多时限高滚动，别把下面的详细区挤没了 -->
                    <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlertList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- 左：五节分析。ItemsControl 两层嵌套（节 → 行），行的颜色和标记在
                 code-behind 里预先算好（见 AnalysisLineVm），XAML 这边不写 converter。 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                           Foreground="#1F4E79" Margin="0,0,0,4" />
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Mark}"
                                                               Foreground="{Binding Brush}" FontWeight="Bold"
                                                               FontFamily="Segoe UI Symbol" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                               FontFamily="Consolas" FontSize="13"
                                                               HorizontalAlignment="Right" Margin="0,0,10,0"
                                                               Foreground="{Binding Brush}"
                                                               FontWeight="{Binding Weight}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Change}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               Foreground="#555555" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Note}"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#666666" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <!-- 本节结论：整节看下来该得出什么，不让用户自己拼 -->
                                <Border Background="#F2F7FB" BorderBrush="#D6E4F0" BorderThickness="1"
                                        Padding="8,5" Margin="0,6,0,0"
                                        Visibility="{Binding ConclusionVisibility}">
                                    <TextBlock Text="{Binding Conclusion}" TextWrapping="Wrap" FontSize="12.5" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ToolTip="左右拖动可调整表格和趋势图的比例" />

            <!-- 右：趋势小图。只回答"在变好还是变坏"——只取同月份的报告期（避免累计口径
                 把趋势画成锯齿），见 FinancialAnalyzer.BuildTrends。 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="趋势（同期比较，最多8期）" FontSize="13" FontWeight="Bold"
                               Foreground="#1F4E79" Margin="0,0,0,4" />
                    <TextBlock x:Name="TrendHintText" FontSize="11" Foreground="#888888"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl x:Name="TrendList" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 共用横坐标：只有最后一张图有报告期标签，所以它高一点。
                                     图与图之间不留间隙（Margin 0），看起来像一张连续的图。 -->
                                <Border BorderBrush="#E8E8E8" BorderThickness="1,1,1,0"
                                        Height="{Binding Height}">
                                    <oxy:PlotView Model="{Binding Model}" Background="White" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部只留按钮（异常项已挪到第 1 行） -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11"
                           Foreground="#888888" Margin="0,0,16,0" />
                <Button Content="复制全文" Width="90" Click="CopyAll_Click"
                        ToolTip="把整份分析复制成纯文本，可以贴到分析笔记里" />
                <Button Content="关闭" Width="90" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
