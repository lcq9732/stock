<Window x:Class="StockPlatform.Analyzer.FinancialAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:StockPlatform.Analyzer"
        Title="分析详情" MinHeight="500" MinWidth="1240"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Foreground}">
    <!-- 财务分析（2026-08-27 新增）——把 52 个财务科目翻译成人能一眼看懂的判断。
         不是再列一张比率表：每行都带"这意味着什么"，每节末尾给结论，最后汇总异常项。
         计算全在 FinancialAnalyzer 里（纯计算、不联网），这里只负责画。

         布局（2026-09-16 改成三列，见 doc/capital-diagnosis-design.md §7）：
           ① 1.57* (min 520)：资金面诊断（六个维度），整列一个 ScrollViewer
           ② 2.43* (min 490)：财报分析，标题 = 报告期 + 总体判断，右端是同比基准/阈值说明
           ③ 1.00* (min 240)：事件（上，封顶 320）+ 趋势小图（下），两个独立滚动区
         这个比例是用户在实机上拖出来后定下的，不是估算值。
         股票名/价格/总体判断**通栏**在三列之上——总体判断是对整只票的，不专属财报那一列
         （原先它跟第②列标题合并在一行，第②列标题改成报告期之后就没地方了）。

         宽度是算过的：屏幕 1920×1040，SizeToScreen 0.92 → 窗口 1766，减 Margin 和两条
         splitter 还剩约 1730 可分。第②列有硬下限：那张七列表死宽 = 标记22+项目名150+
         数值92+变化130 = 394，加说明列至少 80 → 490；**银行体检表多「条目号」「参考值」
         两列要 730**，所以中间那条 GridSplitter 必须留着让用户拖。
         第③列原先按"现在的一半"给了 190 固定，实机一看图标签挤在一起，用户拖宽到 377
         后定为默认（1.0*，min 240）。

         ⚠ 第①列仍要滚（六个维度全展开约 900px，可用高度约 860），但比事件还在这一列时少滚
         不少——这正是 2026-09-16 把事件挪到第③列的原因：那一列竖向空间富余。
         用户定的是"先全部排上去，超过屏幕有 Scroll 就行"，六个维度不折叠。
         窗口开到屏幕九成大，见 TextFitter.SizeToScreen。 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 通栏：股票名 / 价格 / 总体判断 / 复制全文 -->
            <RowDefinition Height="*" />      <!-- 三列 -->
        </Grid.RowDefinitions>

        <!-- ═══ 通栏标题行 ═══
             「复制全文」挪到这里：原先它单独占窗口底部一整行，那行除了两个按钮什么都没有，
             省下来给数据（用户 2026-09-16）。「关闭」按钮跟着去掉了——右上角的 X 和 Esc
             （Window 的 IsCancel 行为）都还在。 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HeaderText" FontSize="17" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="复制全文" Width="90" Click="CopyAll_Click"
                    VerticalAlignment="Center"
                    ToolTip="把整份分析复制成纯文本（含六个维度的结论），可以贴到分析笔记里" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- 列宽比例 = 用户 2026-09-16 在实机上**手动拖出来的**那一版，直接定为默认。
                 （最初按估算给的是 1.05* / 0.95* / 190固定；实机一看第②列的财报明细行太挤、
                 第③列 190 又窄到图标签打架，用户拖成 591 : 916 : 377 后说"就按这个"。）
                 写成 star 而不是像素：换屏幕/改窗口大小时按比例缩放，拖动手感也保持不变。
                 MinWidth 仍是硬下限，见下。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.57*" MinWidth="520" />
                <ColumnDefinition Width="6" />
                <!-- ⚠ 490 是硬下限：五节明细那张七列表死宽 394（标记22+项目名150+数值92+变化130）
                     + 说明列至少 80。银行体检表多「条目号」「参考值」两列要 730，窄了会换行
                     ——所以这两条 splitter 必须留着能拖。 -->
                <ColumnDefinition Width="2.43*" MinWidth="490" />
                <ColumnDefinition Width="6" />
                <!-- 240：OxyPlot 的纵轴刻度 + 报告期标签再窄就开始打架（190 实测过，太挤）。 -->
                <ColumnDefinition Width="1.0*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 第①列：资金面诊断（六个维度）═══
                 事件 2026-09-16 挪到第③列趋势图上面了（用户实机看过后的决定）：那一列竖向
                 空间富余，而这一列六个维度全展开约 900px、本来就要滚，再顶一个 420 的事件区
                 等于凭空多滚半屏。 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel>
                    <local:CapitalDiagnosisPanel x:Name="DiagnosisPanel" />
                    <TextBlock x:Name="DiagnosisNoteText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Theme.Foreground.Muted}" Margin="0,2,0,8" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ToolTip="左右拖动可调整「事件+诊断」和「财报」的比例" />

            <!-- ═══ 第②列：财报分析 ═══
                 标题就是报告期（"2026年中报"），动态取自 report.PeriodName——不能写死，
                 可能是中报/三季报/年报。 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 报告期 + 总体判断。总体判断 2026-09-16 从通栏标题挪到这里（用户要求）：
                     通栏那行右边被「复制全文」占着、能给它的横向空间有限，而这一列标题右边
                     本来就空着一大片。而且那句话讲的就是这期财报，跟列标题在一起更顺。
                     两段由 code-behind 用 Inlines 拼（见构造函数）。 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PeriodTitleText" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Accent.Deep}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="0,0,12,0" />
                    <!-- 「同比基准 / 阈值」解释的是**这一列**的数据：同比基准说明右边 +54.8% 那些
                         同比数是拿哪一期比出来的，阈值说明 ✓ ! ✗ 的判定线在哪。2026-09-16 从通栏
                         右上角挪来——放在那里紧挨着趋势图，会被读成在说趋势图（用户指出）。 -->
                    <TextBlock Grid.Column="1" x:Name="FooterText" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"
                               Foreground="{DynamicResource Theme.Foreground.Muted}" />
                </Grid>

            <!-- 第 1 行同时容纳两块（都是默认隐藏、按需显示）：
                 ① 出错提示（没有财务数据时）——正常情况下总体判断已并进标题行，这块不出现
                 ② 需要留意的项 —— 2026-08-27 从窗口底部挪到这里。阅读顺序应该是
                    "标题给结论 → 先知道有哪几项要留意 → 再往下看详细时就会盯着这几项"，
                    放在底部等于看完全部细节才告诉你重点在哪，顺序是反的。 -->
            <StackPanel Grid.Row="1">
                <Border x:Name="HeadlineBorder" Background="{DynamicResource Theme.Warn.Background}" BorderBrush="{DynamicResource Theme.Warn.Border.Deep}"
                        BorderThickness="1" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" FontSize="14" />
                </Border>

                <Border x:Name="AlertBorder" Background="{DynamicResource Theme.Danger.Background}" BorderBrush="{DynamicResource Theme.Danger.Border}"
                        BorderThickness="1" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="AlertTitle" FontWeight="Bold" Foreground="{DynamicResource Theme.Danger.Foreground}" Margin="0,0,0,3" />
                        <!-- 异常项多时限高滚动，别把下面的详细区挤没了 -->
                        <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlertList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

                <!-- 左：五节分析。ItemsControl 两层嵌套（节 → 行），行的颜色和标记在
                     code-behind 里预先算好（见 AnalysisLineVm），XAML 这边不写 converter。 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SectionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Grid.IsSharedSizeScope 放在**节**上而不是整份列表上（2026-09-19）：
                                     项目名列改成 Auto 之后要靠它把同一节各行对齐，否则每行各宽各的、
                                     数值参差不齐。按节而不是按全表共享，是因为银行体检表的项目名特别长
                                     （"房地产/城投敞口、区域集中度、前十大客户占比"），全表共享的话
                                     它会把其它五节的项目名列一起撑宽。 -->
                                <StackPanel Margin="0,0,0,14" Grid.IsSharedSizeScope="True">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.Accent.Deep}" Margin="0,0,0,4" />
                                    <Border BorderBrush="{DynamicResource Theme.Border.Soft}" BorderThickness="0,1,0,0">
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 一行数据 = 上下两块（2026-09-19 改）：
                                                         上面是原来那张七列 Grid，下面**只在说明很长时**才出现的整行说明。
                                                         为什么要拆：行高由最窄的那一列决定，而说明列只有 ~215px；一句
                                                         六十字的说明在那里要换四五行，左边"项目名/数值/变化"三列就跟着
                                                         空转四五行。挪到下面那一行，宽度变成 ~600px，同样的字数少占一半
                                                         高度。短说明**不挪**（见 AnalysisLineVm.NoteInlineMaxChars）：
                                                         挪下去要多占一个基线，反而更高。 -->
                                                    <StackPanel Margin="0,3">
                                                    <!-- 六列。首列"条目号"只有银行体检表用得上（2026-08-29），其它节绑定为空、
                                                         TextBlock 走 Collapsed，Auto 列宽收缩到 0。
                                                         最后一列同时承载「参考值」和「短说明」——这两者**互斥**：有参考值的行
                                                         说明一律沉到下面那一行（见 AnalysisLineVm.NoteGoesBelow），而普通五节
                                                         根本没有参考值。合成一列是 2026-09-19 改的，原先各占一列，两个都是 Auto，
                                                         放不下时 Grid 不肯压缩 Auto 列，参考值就整段溢出到右边界外被裁掉
                                                         （银行表第 02、03 条实测）。改成 * 之后列会被压缩，TextWrapping 就生效。 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="22" />
                                                            <!-- 原先是死宽 150：短名字（"PB"、"年化 ROE"）后面白空一大截，
                                                                 把数值往右推、说明列跟着变窄。改成 Auto + SharedSizeGroup：
                                                                 宽度 = 本节最宽的那个项目名（TextBlock 上有 MaxWidth 兜底），
                                                                 右边留 5px 空隙，省下的宽度都归后面的列。 -->
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AnalysisLabel" />
                                                            <!-- ⚠ 闸设在 TextBlock 的 MaxWidth 上，不是这里（2026-09-19 踩过）：
                                                                 Auto 列在 Measure 阶段给子元素的是**无限宽度**，TextBlock
                                                                 已经按自然宽度量好了，列宽再被 ColumnDefinition.MaxWidth
                                                                 限住也不会重新换行——只会因为右对齐向左溢出，压在项目名上。 -->
                                                            <!-- ⚠ 这一列**不要**加 SharedSizeGroup（2026-09-19 试过又撤掉）：
                                                                 共享宽度会被本节最宽的那个"数值"绑架，而银行体检表第 09 条把一整句
                                                                 "ROE ↓　成本收入比 ↓改善…"放在数值位上（限宽后 154px），于是十二条
                                                                 的数值列全被撑成 154，反过来把参考值挤得折行。实际数据里数值都不超过
                                                                 92，MinWidth 就够让右边界看齐。 -->
                                                            <ColumnDefinition Width="Auto" MinWidth="92" />
                                                            <!-- 纯 Auto，既不留死宽也不跨行共享（2026-09-19 定）：
                                                                 后面那一列是**针对本行的说明**，跟别的行没有关系，不需要对齐；
                                                                 让它紧跟在变化值后面，短的行就不会白空一大片。
                                                                 需要对齐的是数值列——那是一组可比的数字，看齐了才好扫。
                                                                 硬闸同样在 TextBlock 的 MaxWidth 上，见上面数值列的说明。 -->
                                                            <ColumnDefinition Width="Auto" />
                                                            <!-- 参考值 / 短说明共用这一列，必须是 * 不能是 Auto，理由见上。 -->
                                                            <ColumnDefinition Width="*" MinWidth="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Clause}"
                                                                   Visibility="{Binding ClauseVisibility}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{DynamicResource Theme.Foreground.Disabled}" Margin="0,1,6,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Mark}"
                                                                   Foreground="{Binding Brush}" FontWeight="Bold"
                                                                   FontFamily="Segoe UI Symbol" />
                                                        <!-- MaxWidth 130 —— 十个汉字正好不折（2026-09-19 来回试出来的落点）。
                                                             这一列按本节最宽的项目名取宽，所以银行体检表里"房地产/城投敞口、
                                                             区域集中度、前十大客户占比"那种二十来字的名字必须封顶，否则整列
                                                             250px 起、同节的"PB""ROE（年化）"后面白空一大截。
                                                             ⚠ **别再往下压**：试过 105，"核心一级资本充足率""信用减值损失（倒推）"
                                                             "单一最大客户贷款比例"这些十来个字的名字全开始折行，用户否掉了。
                                                             短名字后面那截空隙在"数值列要对齐成一条线"的前提下消不掉——想再紧凑
                                                             只能让项目名列不对齐、数值紧跟每行名字，那样数值列就参差了。 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                                   TextWrapping="Wrap" MaxWidth="130"
                                                                   Margin="0,0,5,0" />
                                                        <!-- MaxWidth：银行体检表第 09 条把一整句"ROE ↓　成本收入比 ↓改善…"
                                                             放在数值位上，不封顶它能把这一列撑到 259px、挤垮后面所有列。 -->
                                                        <TextBlock Grid.Column="3" Text="{Binding Value}"
                                                                   TextWrapping="Wrap" MaxWidth="160"
                                                                   FontFamily="Consolas" FontSize="13"
                                                                   HorizontalAlignment="Right" Margin="0,0,10,0"
                                                                   Foreground="{Binding Brush}"
                                                                   FontWeight="{Binding Weight}" />
                                                        <!-- MaxWidth 260（2026-09-19 从 180 放宽）：变化值是"同比 X　较上期末 Y"
                                                             这样一句完整对照，断在中间最难读，260 够放下最长的那种
                                                             （"同比 +1094.56 亿　较上期末 +260.99 亿"实测约 270px 也只折一次）。
                                                             当初设 180 是怕它撑开整列把说明挤没——那个风险现在由说明列自己的
                                                             MinWidth 90 兜住了，不会再出现被压成一字一行的竖排。 -->
                                                        <TextBlock Grid.Column="4" Text="{Binding Change}"
                                                                   TextWrapping="Wrap" MaxWidth="260"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{DynamicResource Theme.Foreground.Subtle}" Margin="0,0,14,0" />
                                                        <!-- 参考值（体检报告里的"正常范围"）和短说明共用这一格，两者互斥，
                                                             实际只会显示其中一个；不设 MaxWidth，让 * 列自己决定宽度。 -->
                                                        <StackPanel Grid.Column="5">
                                                            <TextBlock Text="{Binding Reference}"
                                                                       Visibility="{Binding ReferenceVisibility}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11.5" Foreground="{DynamicResource Theme.Accent.Link}" />
                                                            <!-- 只放短说明；长的走下面那条整行（NoteInline / NoteBlock 二选一） -->
                                                            <TextBlock Text="{Binding NoteInline}"
                                                                       Visibility="{Binding NoteInlineVisibility}"
                                                                       TextWrapping="Wrap" FontSize="12"
                                                                       Foreground="{DynamicResource Theme.Foreground.Subtle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- 长说明：跨整列宽。34 = 标记列 22 + 一个汉字 12，也就是**相对项目名缩进
                                                         一个字**：齐头会看起来像下一个项目，缩一个字就够读出"它属于上面那一行"，
                                                         再多缩就是白丢宽度、让长说明多换行。子项（"└ …"）的说明也用这个固定值，
                                                         不跟着它自己那层缩进再缩一次。
                                                         说明为空或够短时 Collapsed，完全不占高度。 -->
                                                    <TextBlock Text="{Binding NoteBlock}"
                                                               Visibility="{Binding NoteBlockVisibility}"
                                                               TextWrapping="Wrap" FontSize="12" Margin="34,2,0,0"
                                                               Foreground="{DynamicResource Theme.Foreground.Subtle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <!-- 本节结论：整节看下来该得出什么，不让用户自己拼 -->
                                    <Border Background="{DynamicResource Theme.Info.Background}" BorderBrush="{DynamicResource Theme.Info.Border}" BorderThickness="1"
                                            Padding="8,5" Margin="0,6,0,0"
                                            Visibility="{Binding ConclusionVisibility}">
                                        <TextBlock Text="{Binding Conclusion}" TextWrapping="Wrap" FontSize="12.5" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ToolTip="左右拖动可调整财报和趋势图的比例" />

            <!-- ═══ 第③列：事件（上）+ 趋势小图（下）═══
                 两个**独立**滚动区，不是一个：往下滚看毛利率那张图时事件不该跟着滚走——
                 "能对照"的前提正是其中一个不动。（这也是 2026-09-14 事件最初放右栏时的理由，
                 2026-09-16 短暂挪到第①列后又挪回来。）

                 事件封顶 320 而不是原来的 420：这一列比当时窄（377 vs 1*），同样的事件文本
                 换行更多、更占高度，而下面五张趋势图合计约 700px——给事件太多，图就全挤到
                 滚动条里去了。内容少于 320 时只占内容那么高，不白占。 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MaxHeight="320" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:StockWatchPanel x:Name="WatchPanel" Grid.Row="0" Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 口径说明 2026-09-16 从常驻一行收进标题的 Tooltip（用户要求）：
                             那段话解释的是"为什么只取同月份的报告期"，看两次就不用再看了，
                             而它在 190 出头的窄列里要占掉四五行。ⓘ 提示有东西可看。
                             跟资金面诊断那六个维度的做法一致，见 CapitalDiagnosisPanel。 -->
                        <TextBlock x:Name="TrendTitleText" Text="趋势（同期比较，最多8期） ⓘ"
                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                                   ToolTipService.ShowDuration="60000"
                                   Foreground="{DynamicResource Theme.Accent.Deep}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="TrendList" BorderBrush="{DynamicResource Theme.Border.Soft}" BorderThickness="0,0,0,1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 共用横坐标：只有最后一张图有报告期标签，所以它高一点。
                                         图与图之间不留间隙（Margin 0），看起来像一张连续的图。 -->
                                    <Border BorderBrush="{DynamicResource Theme.Border.Soft}" BorderThickness="1,1,1,0"
                                            Height="{Binding Height}">
                                        <oxy:PlotView Model="{Binding Model}" Background="{DynamicResource Theme.Chart.Background}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
