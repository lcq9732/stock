<Window x:Class="StockPlatform.Analyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StockPlatform.Analyzer"
        Title="A股批量分析" Height="700" Width="1100" MinWidth="900" MinHeight="500" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- DataGridCheckBoxColumn 默认要点两下才能勾选（第一下只是让单元格获得焦点/选中，第二下
             才真正切到复选框本身）——这里在鼠标按下的Tunneling阶段就提前让单元格获得焦点，同一次
             点击就能落到复选框上，一下就能勾选。隐式样式（没写x:Key），自动套用到本窗口所有
             DataGrid的所有单元格，不需要在每个DataGrid上单独设置。 -->
        <Style TargetType="DataGridCell">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown" />
            <!-- 选中行默认是系统深蓝底+白字，会把各列自定义的红/绿/橙文字压得看不清——改成浅蓝底、
                 默认字保持黑色；带局部 Foreground 的彩色文字（涨跌/动作列等）不受影响，选中后照常
                 显示各自颜色。 -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9E8FB" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="BorderBrush" Value="#D9E8FB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部"手动拷贝数据库"提示已去掉——数据改成用下面的"从服务端更新数据"按钮自动下载。 -->

        <!-- Data status — also shared, both methods read the same local file. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Binding DataStatusText}" VerticalAlignment="Center" FontWeight="Bold" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="80" Margin="12,0,0,0"
                    ToolTip="重新拷贝了数据库文件之后点这个，不用重启程序" />
            <Button Content="从服务端更新数据" Command="{Binding SyncCommand}" Width="130" Margin="8,0,0,0"
                    ToolTip="首次下载全量数据库，之后只下载并合并每日增量（公开下载，无需登录）" />
            <TextBlock Text="{Binding SyncStatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#084298" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>

        <!-- Four independent analysis methods (doc/analysis-app-design.md section 3.2) plus a
             cross-method 自选股 tab — each tab has its own controls/results/log, switching tabs
             doesn't affect the others. -->
        <TabControl Grid.Row="2" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="每日晨检">
                <Grid DataContext="{Binding MorningCheckTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="每天早上：先点上方“从服务端更新数据”，再点“刷新”，然后按下面“今日行动建议”执行"
                                   VerticalAlignment="Center" Foreground="Gray" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Width="90" Margin="16,0,0,0"
                                ToolTip="用本地最新数据重算红绿灯和自选股体检" />
                        <Button Content="&#8505;" FontWeight="Bold" FontSize="16" Width="28" Margin="6,0,0,0"
                                Command="{Binding ShowCriteriaInfoCommand}" ToolTip="查看各条纪律的规则与回测依据" />
                        <TextBlock Text="{Binding DataDateText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#084298" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- 大盘总开关：先给一句大字结论，下面列6个指数的红绿灯明细 -->
                    <GroupBox Grid.Row="1" Header="大盘总开关（沪深300 + 创业板指 vs 各自60日线）" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding GateText}" Foreground="{Binding GateColor}" FontSize="15" FontWeight="Bold" Margin="4,6,4,6" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding IndexRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      AlternatingRowBackground="#F5F5F5" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="指数" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="收盘（日期）" Binding="{Binding CloseText}" Width="130" />
                                    <DataGridTextColumn Header="MA20" Binding="{Binding Ma20Text}" Width="110" />
                                    <DataGridTextColumn Header="MA60" Binding="{Binding Ma60Text}" Width="80" />
                                    <DataGridTextColumn Header="vs 60日线" Binding="{Binding StateText}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding StateColor}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 自选股体检：问题最严重的排最前 -->
                    <GroupBox Grid.Row="2" Header="自选股体检（15%回撤止损 / +50%止盈减仓 / 户数暴增警示 / 60日线下不加仓）">
                        <DataGrid ItemsSource="{Binding StockRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F5F5"
                                  ToolTip="从各选股Tab“加入自选”的股票每天在这里逐只体检；问题最严重的排最前">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="70" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="55">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="ToolTip" Value="持仓=自选股Tab里填过买入价（止损/止盈按真实成本算）；观察=还没买" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StatusColor}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 方法列表头带下拉过滤器：选某个方法后，表格和下面的"今日行动建议"都只算
                                     该方法选出的股票（含平均涨跌/上涨占比），用来横向对比各选股方法的表现。
                                     列头不在行的可视树里、拿不到 Tab 的 DataContext，所以用 RelativeSource
                                     往上找 DataGrid 再取它的 DataContext（WPF 里列头绑定的标准做法）。
                                     CanUserSort=False：避免点下拉时顺带触发这一列的排序。 -->
                                <DataGridTextColumn Binding="{Binding Method}" Width="150" CanUserSort="False">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="方法" VerticalAlignment="Center" />
                                            <ComboBox Width="98" Margin="6,0,0,0" Padding="4,1"
                                                      ItemsSource="{Binding DataContext.MethodFilters, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding DataContext.SelectedMethodFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                      DisplayMemberPath="Display"
                                                      ToolTip="按选股方法过滤：只看某个方法选出的股票，表格和&quot;今日行动建议&quot;（含平均涨跌、上涨占比）都跟着只算这个方法，便于横向对比各方法表现。括号里是该方法的股票只数。切回&quot;全部方法&quot;看全部" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="基准日期" Binding="{Binding DataDate}" Width="95">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="ToolTip" Value="持仓=买入日期（带&quot;买&quot;字）；观察=自选那天。涨跌/回撤都从这天起算" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="最新收盘" Binding="{Binding LatestCloseText}" Width="110" />
                                <DataGridTextColumn Header="60日线" Binding="{Binding Ma60Text}" Width="70" />
                                <DataGridTextColumn Header="较基准涨跌" Binding="{Binding SincePickText}" Width="90">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="ToolTip" Value="持仓=较买入价；观察=较自选日收盘价" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding SincePickColor}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="持仓盈亏" Binding="{Binding PnlText}" Width="130">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="ToolTip" Value="仅持仓显示：填了股数=盈亏金额（涨跌幅），只填买入价=涨跌幅" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding PnlColor}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="距高点回撤" Binding="{Binding DrawdownText}" Width="90" />
                                <DataGridTextColumn Header="户数环比" Binding="{Binding HolderChangeText}" Width="120" />
                                <DataGridTextColumn Header="参考价（纪律换算）" Binding="{Binding AdviceText}" Width="185">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="ToolTip" Value="持仓=建议卖出价：止损线(买入后最高收盘×0.85)、止盈线(买入价×1.5)；观察=建议买入价：线下为站上60日线的价位、线上为回踩MA20位置。是纪律触发条件的价格换算，不是预测" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0F6674" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="今日动作" Binding="{Binding ActionText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ActionColor}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="今日行动建议" Margin="0,8,0,0">
                        <TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True" FontFamily="Microsoft YaHei" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 ToolTip="可用鼠标拖选、Ctrl+C 复制" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="三角收敛">
                <Grid DataContext="{Binding TriangleConvergenceTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="固定使用日线" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBlock Text="形态窗口(天)：" VerticalAlignment="Center" Margin="16,0,0,0"
                                   ToolTip="在最近N天内寻找摆动高/低点并拟合两条趋势线" />
                        <TextBox Text="{Binding Lookback, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" />

                        <TextBlock Text="摆动点窗口(±天)：" VerticalAlignment="Center" Margin="12,0,0,0"
                                   ToolTip="前后各N天都不比它高/低，才算一个摆动高点/低点" />
                        <TextBox Text="{Binding SwingWindow, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" />

                        <TextBlock Text="R²下限：" VerticalAlignment="Center" Margin="12,0,0,0"
                                   ToolTip="压力线/支撑线拟合优度(R²)都要达到这个下限才算形态成立；调低会放宽判定，可能多选出一些拟合不太整齐的股票。可输入小数，如0.45" />
                        <TextBox Text="{Binding MinR2, UpdateSourceTrigger=LostFocus}" Width="50" Margin="4,0" />

                        <Button Content="开始分析" Command="{Binding AnalyzeCommand}" Width="90" Margin="16,0,0,0" />
                        <Button Content="&#8505;" FontWeight="Bold" FontSize="16" Width="28" Margin="6,0,0,0"
                                Command="{Binding ShowCriteriaInfoCommand}" ToolTip="查看入选条件说明" />
                        <Button Content="加入自选" Command="{Binding AddToWatchlistCommand}" Width="80" Margin="16,0,0,0"
                                ToolTip="把左边表格里勾选的股票加入自选，供以后跟踪" />
                        <Button Content="导出Excel" Command="{Binding ExportCommand}" Width="80" Margin="8,0,0,0"
                                ToolTip="把当前结果列表导出成 Excel(.xlsx)" />
                        <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <!-- Results — only stocks that satisfy all 3 criteria are ever added here (see
                         TriangleConvergenceTabViewModel.RunAnalyzeAsync). -->
                    <DataGrid x:Name="TriangleConvergenceGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              ToolTip="勾选后点&quot;加入自选&quot;可以跟踪；点&quot;条件详情&quot;/&quot;行情详情&quot;查看对应图表">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" CanUserSort="False">
                                <!-- 点表头的复选框 = 整列全选/全不选（见 MainWindow.SelectAllHeader_Click） -->
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="板块" Binding="{Binding Board}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="收敛质量" Binding="{Binding ConvergenceQualityText}" Width="80" IsReadOnly="True"
                                                SortMemberPath="SortScore" />
                            <DataGridTextColumn Header="满足数" Binding="{Binding SatisfiedCount}" Width="70" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="操作" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="条件详情" Width="70" Margin="2,1" Click="TriangleConvergenceCriteriaButton_Click" />
                                            <Button Content="行情详情" Width="70" Margin="2,1" Click="QuoteDetailButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="运行日志" Margin="0,10,0,0">
                        <TextBox local:LogText.Lines="{Binding LogLines}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 ToolTip="可用鼠标拖选、Ctrl+C 复制，Ctrl+A 全选" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="峰哥法">
                <Grid DataContext="{Binding FoundationTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="固定使用日线" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBlock Text="近N个交易日内有涨停：" VerticalAlignment="Center" Margin="16,0,0,0"
                                   ToolTip="最近多少个交易日内出现过涨停就列出来，默认7" />
                        <TextBox Text="{Binding Lookback, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" />

                        <Button Content="开始分析" Command="{Binding AnalyzeCommand}" Width="90" Margin="16,0,0,0" />
                        <Button Content="&#8505;" FontWeight="Bold" FontSize="16" Width="28" Margin="6,0,0,0"
                                Command="{Binding ShowCriteriaInfoCommand}" ToolTip="查看入选条件说明" />
                        <Button Content="加入自选" Command="{Binding AddToWatchlistCommand}" Width="80" Margin="16,0,0,0"
                                ToolTip="把左边表格里勾选的股票加入自选，供以后跟踪" />
                        <Button Content="导出Excel" Command="{Binding ExportCommand}" Width="80" Margin="8,0,0,0"
                                ToolTip="把当前结果列表导出成 Excel(.xlsx)" />
                        <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <!-- Results — only stocks that satisfy all 3 criteria are ever added here (see
                         FoundationTabViewModel.RunAnalyzeAsync). -->
                    <DataGrid x:Name="FoundationGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              ToolTip="勾选后点&quot;加入自选&quot;可以跟踪；点&quot;条件详情&quot;/&quot;行情详情&quot;查看对应图表">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" CanUserSort="False">
                                <!-- 点表头的复选框 = 整列全选/全不选（见 MainWindow.SelectAllHeader_Click） -->
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="板块" Binding="{Binding Board}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="近N日涨停次数" Binding="{Binding SortScore}" Width="110" IsReadOnly="True" SortMemberPath="SortScore" />
                            <DataGridTemplateColumn Header="操作" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="条件详情" Width="70" Margin="2,1" Click="FoundationCriteriaButton_Click" />
                                            <Button Content="行情详情" Width="70" Margin="2,1" Click="QuoteDetailButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="运行日志" Margin="0,10,0,0">
                        <TextBox local:LogText.Lines="{Binding LogLines}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 ToolTip="可用鼠标拖选、Ctrl+C 复制，Ctrl+A 全选" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="耀哥法">
                <Grid DataContext="{Binding BottomReboundTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="固定使用日线" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBlock Text="DIF阈值：" VerticalAlignment="Center" Margin="16,0,0,0"
                                   ToolTip="DIF需要 ≥ -此阈值；0表示DIF必须≥0，调大后允许DIF略低于0轴也算&quot;接近0轴&quot;" />
                        <TextBox Text="{Binding DifThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0" />

                        <Button Content="开始分析" Command="{Binding AnalyzeCommand}" Width="90" Margin="16,0,0,0" />
                        <Button Content="&#8505;" FontWeight="Bold" FontSize="16" Width="28" Margin="6,0,0,0"
                                Command="{Binding ShowCriteriaInfoCommand}" ToolTip="查看入选条件说明" />
                        <Button Content="加入自选" Command="{Binding AddToWatchlistCommand}" Width="80" Margin="16,0,0,0"
                                ToolTip="把左边表格里勾选的股票加入自选，供以后跟踪" />
                        <Button Content="导出Excel" Command="{Binding ExportCommand}" Width="80" Margin="8,0,0,0"
                                ToolTip="把当前结果列表导出成 Excel(.xlsx)" />
                        <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <!-- Results — only stocks that satisfy all 3 criteria are ever added here (see
                         BottomReboundTabViewModel.RunAnalyzeAsync). -->
                    <DataGrid x:Name="BottomReboundGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              ToolTip="勾选后点&quot;加入自选&quot;可以跟踪；点&quot;条件详情&quot;/&quot;行情详情&quot;查看对应图表">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" CanUserSort="False">
                                <!-- 点表头的复选框 = 整列全选/全不选（见 MainWindow.SelectAllHeader_Click） -->
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
