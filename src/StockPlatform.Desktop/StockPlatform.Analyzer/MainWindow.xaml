                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：板块榜（按涨跌幅降序，点某行右侧列出成分股） -->
                        <DataGrid Grid.Column="0" x:Name="BoardGrid" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F5F5F5"
                                  SelectionMode="Single" ToolTip="点某个板块，右侧列出它的成分股">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="板块" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="涨跌幅" Binding="{Binding ChangePctText}" Width="80" SortMemberPath="ChangePct">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ChangeColor}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="成分股" Binding="{Binding MemberCount}" Width="60" />
                                <DataGridTextColumn Header="成交额(亿)" Binding="{Binding AmountYi, StringFormat=F1}" Width="90" />
                                <DataGridTextColumn Header="领涨股" Binding="{Binding LeaderName}" Width="100" />
                                <DataGridTemplateColumn Header="操作" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="板块K线" Width="80" Margin="2,1" Click="BoardIndexQuoteDetailButton_Click"
                                                    ToolTip="查看该板块指数的K线图（本地按成分股等权合成，需先在Fetcher里合成过板块指数并拷贝数据库）" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDDDDD" />

                        <!-- 右：选中板块的成分股 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding MembersHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid Grid.Row="1" x:Name="BoardMemberGrid" ItemsSource="{Binding Members}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="#F5F5F5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="涨跌幅" Binding="{Binding ChangePctText}" Width="90" SortMemberPath="ChangePct">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding ChangeColor}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="操作" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="K线详情" Width="80" Margin="2,1" Click="BoardMemberQuoteDetailButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="查询">
                <Grid DataContext="{Binding QueryTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="股票代码或名称：" VerticalAlignment="Center" />
                        <TextBox Width="200" Margin="4,0" VerticalContentAlignment="Center"
                                 Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="支持部分匹配，如输入 000066 或 长城，回车或点查询">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="查询" Command="{Binding SearchCommand}" Width="90" Margin="8,0,0,0" />
                        <Button Content="加入自选" Command="{Binding AddToWatchlistCommand}" Width="80" Margin="16,0,0,0"
                                ToolTip="把勾选的个股加入自选（记录当天收盘价），加入后可在自选股Tab跟踪、每日晨检Tab逐日体检；指数/ETF/板块不支持" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <DataGrid x:Name="QueryGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              ToolTip="勾选后点&quot;加入自选&quot;可以跟踪；点&quot;K线详情&quot;查看该股票的行情K线图">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" CanUserSort="False">
                                <!-- 点表头的复选框 = 整列全选/全不选（见 MainWindow.SelectAllHeader_Click） -->
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="板块" Binding="{Binding Board}" Width="140" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="K线详情" Width="90" Margin="2,1" Click="QueryQuoteDetailButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="自选股">
                <Grid DataContext="{Binding WatchlistTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="从上面5个方法的结果里勾选后点&quot;加入自选&quot;加进来的股票，记录了当时用的方法/数据日期/价格/判断依据，方便以后回来看效果" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" MaxWidth="500" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Width="80" Margin="16,0,0,0" />
                        <Button Content="移除勾选" Command="{Binding RemoveSelectedCommand}" Width="80" Margin="8,0,0,0" />
                        <Button Content="导出Excel" Command="{Binding ExportCommand}" Width="80" Margin="8,0,0,0"
                                ToolTip="把自选股列表导出成 Excel(.xlsx)" />
                    </StackPanel>

                    <DataGrid x:Name="WatchlistGrid" Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              ToolTip="点&quot;条件详情&quot;查看加入时的判断依据（用最新数据重新画图），点&quot;行情详情&quot;查看当前行情">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" CanUserSort="False">
                                <!-- 点表头的复选框 = 整列全选/全不选（见 MainWindow.SelectAllHeader_Click） -->
                                <DataGridCheckBoxColumn.Header>
                                    <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="板块(概念)" Binding="{Binding Board}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="行业" Binding="{Binding Industry}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="数据日期" Binding="{Binding DataDate}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="当时价格" Binding="{Binding PriceAtPick, StringFormat=F2}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="最新收盘" Binding="{Binding LatestCloseText}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="选中后涨跌幅" Binding="{Binding ChangeText}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ChangeColor}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 手动持仓三列（可直接双击编辑，编辑完点别处即保存）：三个都空=还没买、观察中；
                                 填了=真实持仓，每日晨检的止损/止盈按买入价/买入日算，持仓盈亏列显示金额。 -->
                            <DataGridTextColumn Header="买入日期✎" Binding="{Binding BuyDateText, UpdateSourceTrigger=LostFocus}" Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="双击单元格输入实际买入日期（如 2026-7-29），清空=未持有；编辑完点其它地方自动保存" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="买入价✎" Binding="{Binding BuyPriceText, UpdateSourceTrigger=LostFocus}" Width="75">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="双击单元格输入实际买入价，清空=未持有；编辑完点其它地方自动保存" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="股数✎" Binding="{Binding SharesText, UpdateSourceTrigger=LostFocus}" Width="70">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="双击单元格输入买入股数（用于计算持仓盈亏金额）；编辑完点其它地方自动保存" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="卖出日期✎" Binding="{Binding SellDateText, UpdateSourceTrigger=LostFocus}" Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="卖出后双击输入卖出日期——买入价+卖出价都填了即为已平仓：显示最终已实现盈亏、留痕复盘，晨检不再执行持仓纪律" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="卖出价✎" Binding="{Binding SellPriceText, UpdateSourceTrigger=LostFocus}" Width="75">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="卖出后双击输入实际卖出价；清空则回到持仓状态" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="持仓盈亏" Binding="{Binding HoldingText}" Width="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding HoldingColor}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="满足数" Binding="{Binding SatisfiedText}" Width="70" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="操作" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="条件详情" Width="70" Margin="2,1" Click="WatchlistCriteriaButton_Click" />
                                            <Button Content="行情详情" Width="70" Margin="2,1" Click="WatchlistQuoteDetailButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
