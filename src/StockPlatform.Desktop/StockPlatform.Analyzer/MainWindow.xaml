                    <GroupBox Grid.Row="2" Header="运行日志" Margin="0,10,0,0">
                        <TextBox local:LogText.Lines="{Binding LogLines}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 ToolTip="可用鼠标拖选、Ctrl+C 复制，Ctrl+A 全选" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="因子法">
                <!-- 两张表左右排列（2026-08-03按用户要求从上下改成左右）：左=因子清单，右=最新名单，
                     中间 GridSplitter 可拖动分配宽度。因子说明不再跟随选中行显示（那会占掉一整列宽度），
                     改成每行一个"说明"按钮、点了才弹窗（FactorDetailWindow）。 -->
                <Grid DataContext="{Binding FactorTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="运行因子选股" Command="{Binding RunCommand}" Width="110"
                                ToolTip="加载全量日线跑完整因子评估（约2~3分钟），得到各因子IC、去重结论和合成因子的最新Top50名单。评估协议与已知局限（幸存者偏差等）见 doc/factorlab-design.md" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Muted}"
                                   MaxWidth="900" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- 左窄右宽：日常盯的是右边的股票名单，因子表退居次要、需要时横向滚动或
                             拖 GridSplitter 拉宽来看（2026-08-03 按用户要求调整）。 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" MinWidth="480" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：因子清单。所有列都用固定宽度（不能有 Width="*"）——只要有星号列，
                             DataGrid 就会强制把内容压进可见宽度、永远不出横向滚动条，那样列一多就全挤没了。 -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="因子清单（点&quot;说明&quot;看构造与作用；可横向滚动/拖中缝加宽）"
                                       FontWeight="Bold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                            <DataGrid ItemsSource="{Binding FactorRows}" SelectedItem="{Binding SelectedFactor}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ToolTip="每个因子是什么、有什么用，点该行的&quot;说明&quot;按钮查看；IC等数字在运行评估后填充。列较多，可横向滚动，或拖动两表中间的分隔条加宽本表">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="因子" Binding="{Binding Name}" Width="130" />
                                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="55" />
                                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="60" />
                                    <DataGridTextColumn Header="IC内" Binding="{Binding IcInText}" Width="55" SortMemberPath="IcInValue" />
                                    <DataGridTextColumn Header="ICIR内" Binding="{Binding IcirInText}" Width="58" SortMemberPath="IcirInValue" />
                                    <DataGridTextColumn Header="中性IC内" Binding="{Binding IcNeuInText}" Width="70" SortMemberPath="IcNeuInValue" />
                                    <DataGridTextColumn Header="IC外" Binding="{Binding IcOutText}" Width="55" SortMemberPath="IcOutValue" />
                                    <DataGridTextColumn Header="多空外" Binding="{Binding LsAnnOutText}" Width="62" SortMemberPath="LsAnnOutValue" />
                                    <DataGridTextColumn Header="换手" Binding="{Binding TurnoverText}" Width="50" SortMemberPath="TurnoverValue" />
                                    <DataGridTextColumn Header="去重" Binding="{Binding DedupText}" Width="140" />
                                    <DataGridTemplateColumn Header="操作" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="说明" Width="56" Margin="2,1" Click="FactorExplainButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                      ShowsPreview="True" ToolTip="拖动调整左右宽度" />

                        <!-- 右：最新名单 -->
                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PicksHeaderText}" FontWeight="Bold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                <CheckBox Content="剔除高融资" IsChecked="{Binding FilterHighMargin}" VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="从名单里剔除融资余额占流通市值比过高的股票。&#10;&#10;依据（2026-08-04 十年实测）：融资占比越高，波动率(5.5%→7.9%)、最差单期(-11%→-20%)、Beta(1.07→1.42)全部单调上升；市场暴跌的10期里，占比0~3%的组跑赢指数0.6%、>10%的组跑输3.8%——强平螺旋是真的。&#10;&#10;⚠️但各档的平均收益几乎持平(每20日0.52%~0.66%)，所以这是【降波动】而不是【增收益】的工具，默认不勾。&#10;&#10;剔除后不补位（补进来的是得分更低的股票，那是另一个决策）。非两融标的不受影响。" />
                                <TextBox Width="46" Margin="4,0" VerticalContentAlignment="Center"
                                         Text="{Binding MarginThreshold, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="剔除阈值，小数形式（0.08=8%）。实测风险从3%就开始单调上升、并非到10%才突变，所以默认8%而不是民间说的10%；填0.1更宽松、填0.05更严格。" />
                                <Button Content="加入自选" Command="{Binding AddToWatchlistCommand}" Width="80" Margin="10,0,0,0"
                                        ToolTip="把勾选的股票加入自选（Method=因子法，记录评估时的最新收盘价），加入后可在自选股Tab跟踪、每日晨检Tab逐日体检" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PickRows}" AutoGenerateColumns="False" IsReadOnly="False"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}"
                                      ToolTip="合成因子得分最高的股票；&quot;主要贡献&quot;列出该股得分最高的三个成分因子。排序输出仅供研究，不构成买入建议">
                                <DataGrid.Columns>
                                    <!-- 一点即勾（整格可点）——模板见 Window.Resources 里的 SelectCheckBoxCell -->
                                    <DataGridTemplateColumn Width="36" CanUserSort="False"
                                                            CellTemplate="{StaticResource SelectCheckBoxCell}">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Click="SelectAllHeader_Click" ToolTip="全选 / 全不选" HorizontalAlignment="Center" />
                                        </DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50" IsReadOnly="True" />
                                    <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Header="板块" Binding="{Binding Board}" Width="115" IsReadOnly="True" />
                                    <DataGridTextColumn Header="收盘" Binding="{Binding CloseText}" Width="65" IsReadOnly="True" SortMemberPath="LatestClose" />
                                    <DataGridTextColumn Header="合成得分" Binding="{Binding ScoreText}" Width="72" IsReadOnly="True" SortMemberPath="ScoreValue" />
                                    <DataGridTextColumn Header="融资占比" Binding="{Binding MarginRatioText}" Width="68" IsReadOnly="True" SortMemberPath="MarginRatio" />
                                    <DataGridTextColumn Header="主要贡献因子" Binding="{Binding ContribText}" Width="*" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="操作" Width="116">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentPresenter ContentTemplate="{StaticResource DetailSplitButtonCell}" Content="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="板块热度">
                <Grid DataContext="{Binding BoardTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="概念/题材" GroupName="BoardType" IsChecked="{Binding ShowConcept}" VerticalAlignment="Center" />
                        <RadioButton Content="行业" GroupName="BoardType" IsChecked="{Binding ShowIndustry}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="查询板块：" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBox Width="150" Margin="2,0" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按板块名或领涨股名筛选，边打边筛" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Margin="12,0,0,0"
                                ToolTip="重新拷贝了数据库后点这个，重新读取本地板块数据" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground.Muted}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：板块榜（按涨跌幅降序，点某行右侧列出成分股） -->
                        <DataGrid Grid.Column="0" x:Name="BoardGrid" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}"
                                  SelectionMode="Single" ToolTip="点某个板块，右侧列出它的成分股">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="板块" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="涨跌幅" Binding="{Binding ChangePctText}" Width="80" SortMemberPath="ChangePct">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ChangeColor}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="成分股" Binding="{Binding MemberCount}" Width="60" />
                                <DataGridTextColumn Header="成交额(亿)" Binding="{Binding AmountYi, StringFormat=F1}" Width="90" />
                                <DataGridTextColumn Header="领涨股" Binding="{Binding LeaderName}" Width="100" />
                                <DataGridTemplateColumn Header="操作" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="板块K线" Width="80" Margin="2,1" Click="BoardIndexQuoteDetailButton_Click"
                                                    ToolTip="查看该板块指数的K线图（本地按成分股等权合成，需先在Fetcher里合成过板块指数并拷贝数据库）" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}" />

                        <!-- 右：选中板块的成分股 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding MembersHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid Grid.Row="1" x:Name="BoardMemberGrid" ItemsSource="{Binding Members}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" AlternatingRowBackground="{DynamicResource Theme.Grid.Row.Alternate}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="涨跌幅" Binding="{Binding ChangePctText}" Width="90" SortMemberPath="ChangePct">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding ChangeColor}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="操作" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="K线详情" Width="80" Margin="2,1" Click="BoardMemberQuoteDetailButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
