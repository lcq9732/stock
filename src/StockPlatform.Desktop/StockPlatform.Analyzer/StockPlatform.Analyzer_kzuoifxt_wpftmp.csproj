<Project>
  <PropertyGroup>
    <AssemblyName>StockPlatform.Analyzer</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Chingli\Git\stock\src\StockPlatform.Desktop\StockPlatform.Analyzer\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>StockPlatform.Analyzer</_TargetAssemblyProjectName>
    <RootNamespace>StockPlatform.Analyzer</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockPlatform.Analyzer</RootNamespace>
    <!-- exe 图标（绿色柱状图）——任务栏/窗口标题/资源管理器都用它；托盘 NotifyIcon 也是靠
         ExtractAssociatedIcon(exe) 取的，所以设了这个托盘图标自动变成同一个，无需改代码。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
  </ItemGroup>
  <!-- UseWindowsForms=true (for the tray-icon NotifyIcon, see MainWindow.xaml.cs) makes the SDK's
       ImplicitUsings add a project-wide "global using System.Windows.Forms;" — that collides with
       WPF types of the same name used everywhere else in this WPF app (MessageBox, Button,
       MouseEventArgs, Brushes, Color, ...). Remove just that one implicit using; the tray-icon code
       fully-qualifies every System.Windows.Forms.* type it needs anyway, so nothing else changes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\IndustryMap.tsv" />
  </ItemGroup>
  <!-- 单实例守卫跟 Fetcher 共用同一份源码（不是各自复制一份）——见该文件的类注释 -->
  <ItemGroup>
    <Compile Include="..\Shared\SingleInstanceGuard.cs" Link="Shared\SingleInstanceGuard.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\StockPlatform.Logic\StockPlatform.Logic.csproj" />
    <ProjectReference Include="..\..\StockPlatform.Data\StockPlatform.Data.csproj" />
    <!-- 因子Tab复用 FactorLab 的因子库/评估引擎/名单构建（引用的是它的dll，不影响其独立exe用法） -->
    <ProjectReference Include="..\StockPlatform.FactorLab\StockPlatform.FactorLab.csproj" />
  </ItemGroup>
