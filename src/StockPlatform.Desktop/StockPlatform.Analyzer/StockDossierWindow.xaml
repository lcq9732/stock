<Window x:Class="StockPlatform.Analyzer.StockDossierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="其他数据" Height="800" Width="1400" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <!-- 故意用浅色（跟主窗口各 DataGrid 一致），不跟着"行情详情"用深色——那个窗口深色是为了仿券商
         K线软件，这里是纯数据表格，跟主窗口保持一套观感更省事也更好读。页签在代码里按节动态生成
         （见 StockDossierWindow.xaml.cs BuildTabs），XAML 这里只放骨架。 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" x:Name="SubtitleText" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8" />

        <TabControl Grid.Row="2" x:Name="SectionTabs" />
    </Grid>
</Window>
