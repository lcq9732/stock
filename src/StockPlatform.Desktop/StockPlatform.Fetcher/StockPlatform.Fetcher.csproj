<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StockPlatform.Fetcher</AssemblyName>
    <RootNamespace>StockPlatform.Fetcher</RootNamespace>
    <!-- exe 图标（蓝色下载箭头）——任务栏/窗口标题/资源管理器都用它；托盘 NotifyIcon 也是靠
         ExtractAssociatedIcon(exe) 取的，所以设了这个托盘图标自动变成同一个，无需改代码。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StockPlatform.Logic\StockPlatform.Logic.csproj" />
    <ProjectReference Include="..\..\StockPlatform.Data\StockPlatform.Data.csproj" />
    <ProjectReference Include="..\..\StockPlatform.Scheduling\StockPlatform.Scheduling.csproj" />
  </ItemGroup>

  <!-- 单实例守卫跟 Analyzer 共用同一份源码（不是各自复制一份）——见该文件的类注释 -->
  <ItemGroup>
    <Compile Include="..\Shared\SingleInstanceGuard.cs" Link="Shared\SingleInstanceGuard.cs" />
  </ItemGroup>

  <!-- 界面主题（浅色/深色）——画刷字典 + 控件模板 + ThemeManager 跟 Analyzer 共用同一份源码，
       用 Link 链接进来（跟上面的单实例守卫同样的做法）。Link 决定编译后的资源路径，所以
       ThemeManager 里用相对 Uri "Theme/Colors.Dark.xaml" 就能找到。 -->
  <ItemGroup>
    <Compile Include="..\Shared\Theme\ThemeManager.cs" Link="Shared\Theme\ThemeManager.cs" />
    <Compile Include="..\Shared\Theme\ThemeBrushes.cs" Link="Shared\Theme\ThemeBrushes.cs" />
    <Page Include="..\Shared\Theme\Colors.Light.xaml" Link="Theme\Colors.Light.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\Shared\Theme\Colors.Dark.xaml" Link="Theme\Colors.Dark.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\Shared\Theme\Controls.Common.xaml" Link="Theme\Controls.Common.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\Shared\Theme\Controls.Dark.xaml" Link="Theme\Controls.Dark.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <!-- 主题选择下拉（两个程序共用的 UserControl）——xaml 和它的 code-behind 要成对链接进来 -->
    <Page Include="..\Shared\Theme\ThemeSwitcher.xaml" Link="Theme\ThemeSwitcher.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\Shared\Theme\ThemeSwitcher.xaml.cs" Link="Theme\ThemeSwitcher.xaml.cs">
      <DependentUpon>ThemeSwitcher.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
