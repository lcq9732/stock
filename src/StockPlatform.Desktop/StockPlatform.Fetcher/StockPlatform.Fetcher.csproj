<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StockPlatform.Fetcher</AssemblyName>
    <RootNamespace>StockPlatform.Fetcher</RootNamespace>
    <!-- exe 图标（蓝色下载箭头）——任务栏/窗口标题/资源管理器都用它；托盘 NotifyIcon 也是靠
         ExtractAssociatedIcon(exe) 取的，所以设了这个托盘图标自动变成同一个，无需改代码。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StockPlatform.Logic\StockPlatform.Logic.csproj" />
    <ProjectReference Include="..\..\StockPlatform.Data\StockPlatform.Data.csproj" />
  </ItemGroup>

</Project>
