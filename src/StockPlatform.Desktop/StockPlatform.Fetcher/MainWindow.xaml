<Window x:Class="StockPlatform.Fetcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockPlatform.Fetcher.ViewModels"
        xmlns:local="clr-namespace:StockPlatform.Fetcher"
        Title="A股历史数据获取程序" Height="600" Width="1180" MinWidth="900" MinHeight="400">
    <Window.Resources>
        <vm:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 第1行：共享输入（数据源/公告关键词/定时到） -->
            <RowDefinition Height="Auto" />   <!-- 第2行：个股K线拉取（含专属参数：首次回看→全部、日期→当天） -->
            <!-- 2026-08-15 把原来挤在一行的 11 个控件按"多久点一次"拆成两行：
                 第3行 = 季度级的定期数据（财报季点一次）；第4行 = 一次性回补（更低频）。 -->
            <RowDefinition Height="Auto" />   <!-- 第3行：定期数据（季度级） -->
            <RowDefinition Height="Auto" />   <!-- 第4行：一次性回补 -->
            <RowDefinition Height="Auto" />   <!-- 状态显示 -->
            <RowDefinition Height="*" />      <!-- 运行日志 -->
        </Grid.RowDefinitions>

        <!-- 第1行 · 共享输入：数据源/公告关键词/定时到 —— 都对 拉取全部/补指定历史日/定时拉取 生效 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="数据源：" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}"
                      DisplayMemberPath="Name" Width="100" Margin="4,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                      ToolTip="每次抓取只用一个数据源，不会自动混用；如果当前数据源被限流/连不上，手动切换到另一个再重新点击开始抓取即可（未抓完的股票会被抓到）。作用于：拉取全部/补指定历史日/重新拉取失败/定时拉取（板块、指数成分、股东、融资、龙虎各有固定源，不看这里）" />

            <TextBlock Text="中标/订单公告关键词：" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding AnnouncementKeywordsText, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="4,0"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     ToolTip="逗号分隔的多个关键词，例如：中标,签订合同。清空则不抓公告。拉取全部/补指定历史日/定时拉取时会自动按这里的关键词搜索（巨潮资讯网全文检索+东方财富公告正文提取金额），不需要单独点击" />

            <TextBlock Text="定时到" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding ScheduleTimeText, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     ToolTip="HH:mm，默认18:00。点第2行的两个定时按钮后会等到这个时间再开始；建议18点以后(K线已收盘确认、融资/龙虎已公布)。点击时若已过该时间则立即执行。" />
        </StackPanel>

        <!-- 第2行 · 个股K线拉取：首次回看紧贴 拉取全部/定时拉取全部；日期紧贴 补指定历史日/定时补指定日。
             按钮名 2026-07-31 从"拉取当天/定时拉取当天"改成现在这个——两者耗时其实一样（见
             FetchOrchestrator 类注释的复核结论），唯一差别是"拉取全部"会自动补断档，所以日常一律用
             "拉取全部"，这个按钮只在要补某个过去的具体日期时才用；旧名字让人误以为它是"每天该点的那个"。 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="首次回看：" VerticalAlignment="Center"
                       ToolTip="只影响本地完全没有历史的股票（真正首次运行，或者新上市还没抓过的股票）——已经抓过的股票永远从自己上次抓到的日期继续，不受这个设置影响。只作用于：拉取全部、定时拉取全部" />
            <TextBox Text="{Binding LookbackYearsText, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="4,0"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Text="年" VerticalAlignment="Center" />

            <Button Content="拉取全部" Command="{Binding FetchCommand}" Width="90" Margin="8,0,4,0"
                    ToolTip="【日常收盘后就点这个】必须手动点击才会发起网络请求。程序会自动获取全市场股票列表并逐个抓取——首次拉取近N年历史（N见本行左侧\首次回看\框），之后只抓增量，也会顺带抓流通市值、中标/订单公告、以及融资余额/龙虎榜的当天。按股票逐个记录进度，中途点\停止\或部分股票抓取失败都没关系，重新点会自动只补抓还没抓到的部分，不会重新来过。&#10;&#10;【和\补指定历史日\的区别——这是选它的唯一理由】每只标的都从\自己上次抓到的那天\接着抓到今天，所以中间漏掉的任何天数都会自动补齐。实测2026-07-30那次就自动补回了07-28、07-29两天约5500只个股的日K（那两晚没跑完）。&#10;耗时跟\补指定历史日\其实一样（都要扫全市场市值、都要逐只请求约7400个标的），所以日常没有理由选那个。" />
            <Button Content="定时拉取全部" Command="{Binding ScheduledFetchAllCommand}" Width="100" Margin="0,0,4,0"
                    ToolTip="【无人值守就用这个】点后等到第1行\定时到\的时间再自动跑\拉取全部\——用于收盘后无人值守取当天最终数据，同样带\自动补齐断档\。等待期间可点\停止\取消；点击时若已过该时间则立即执行。程序要一直开着、电脑别休眠。" />

            <TextBlock Text="日期：" Margin="16,0,0,0" VerticalAlignment="Center"
                       ToolTip="格式 yyyy-MM-dd，默认今天。只作用于：补指定历史日、定时补指定日" />
            <TextBox Text="{Binding FetchDayText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="4,0"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     ToolTip="格式 yyyy-MM-dd，默认今天" />
            <Button Content="补指定历史日" Command="{Binding FetchDayCommand}" Width="100" Margin="8,0,4,0"
                    ToolTip="【只在要补某个过去的具体日期时才用它】只抓左边\日期\框那一天的数据（K线+流通市值+资金流+公告+融资/龙虎），不管该股票之前抓到哪天了。K线用本地已有的股票列表（不为K线重新扫全市场），但市值步骤仍会扫一遍全市场、顺带发现新股并抓其完整历史。前置：本地必须已经有库（否则报错），先跑过一次\拉取全部\。&#10;&#10;⚠️【日常别用这个】它\只抓你指定的那一天\、不看每只股票上次抓到哪天，所以中间漏掉的日子它不会补，会永久留空。而它的耗时跟\拉取全部\基本一样（同样要扫全市场市值、同样逐只请求约7400个标的，实测都约2小时）——花同样的时间却少了\自动补齐断档\这层保险。&#10;日常收盘后请点左边的\拉取全部\。" />
            <Button Content="定时补指定日" Command="{Binding ScheduledFetchDayCommand}" Width="100" Margin="0,0,4,0"
                    ToolTip="点后等到第1行\定时到\的时间再自动跑\补指定历史日\(抓\日期\框里那天,默认今天)。等待期间可点\停止\取消。程序要一直开着、电脑别休眠。&#10;&#10;⚠️ 同\补指定历史日\：只抓指定那一天、不补断档，耗时却跟\定时拉取全部\一样。无人值守日常请用左边的\定时拉取全部\。" />

            <!-- 按钮上显示分类文字而不是一个总数（2026-08-19改）：流通市值是整轮扫描，失败时整批
                 代码都会进名单，加总后会显示成"（5547）"、被读成丢了5547只票的数据，实际只是一次
                 市值快照没取到。见 FailedRetrySummary。 -->
            <Button Content="{Binding FailedRetryText, StringFormat='重新拉取失败（{0}）'}"
                    Command="{Binding RetryFailedCommand}" MinWidth="150" Margin="16,0,4,0" Padding="8,0"
                    ToolTip="只重新抓取上次记录的失败项——K线/流通市值/资金净流入/指数成分/指数权重/股东数据/分红 各自独立记录失败，这里会分别重试，跑完会在日志里逐类汇总做了什么。&#10;&#10;括号里按类型分开显示：&#10;· 「K线 12 只」这类是逐只抓的，数字就是缺数据的股票数；&#10;· 「市值 1 轮」是整轮扫描——流通市值一次请求拿回全市场，接口失败时整批代码都会记进名单，所以它只代表'有一轮要重来'，不是几千只票的数据丢了。&#10;&#10;可以反复点击——还有剩的会继续显示，清完显示'无失败'并变灰。" />

            <Button Content="停止" Command="{Binding StopCommand}" Width="70" Margin="4,0"
                    ToolTip="中断当前正在进行的抓取（或定时等待），已经写入本地数据库的部分不会回滚，可以随时重新开始（增量判断会跳过已有数据）" />
        </StackPanel>

        <!-- 第3行 · 定期数据：季度级慢变的几张表，财报季各点一次（都不看上面的输入框）。
             顺序按"点的频率"排：板块最勤 → 一键（含后面全部）→ 各单项。 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="拉取板块" Command="{Binding FetchBoardsCommand}" Width="90" Margin="0,0,4,0"
                    ToolTip="抓取概念/题材板块 + 行业板块的最新行情（涨跌幅/成交额/领涨股）及各板块成分股，整体覆盖写入本地库，供分析程序的\板块热度\页使用。数据来自新浪，是当下快照。拉完会自动接着合成板块指数(用本地已有个股K线按新成分重算,不联网)，不用再单独点。更新频率高、想刷就点。" />
            <Button Content="一键拉取定期数据" Command="{Binding FetchPeriodicCommand}" Width="130" Margin="4,0"
                    ToolTip="不是每天更新的数据一次点完:依次跑 指数成分/权重 → 股东数据 → 财务报表 → 分红送配(全量刷新)。较慢,可能数小时,季度点一次即可。各项内部失败进\重新拉取失败股票\可重试。板块不在这里(它更新快,用左边的\拉取板块\)。前置:先\拉取全部\一次。" />
            <Button Content="拉取财务报表" Command="{Binding FetchFinancialsCommand}" Width="100" Margin="4,0"
                    ToolTip="从新浪抓每只股票【上市以来全部报告期】的关键财务科目(营收/净利润/归母净利/资产/负债/归母权益/经营现金流/营业成本)，写入 FinancialReport 表，供 FactorLab 的基本面因子(ROE/成长/估值等)使用。含2016年后退市的股票(消除幸存者偏差)。&#10;&#10;【按报告期增量】本地已有最新报告期(按法定披露截止日判断:一季报4-30/半年报8-31/三季报10-31/年报次年4-30)的股票整只跳过。首次全量约5500只×3请求≈1.5~2小时；之后每季度财报季点一次即可，平时重复点几乎零成本。失败的下次运行自动重试。&#10;&#10;这一步也已并入\一键拉取定期数据\；这个独立按钮给首次回补用，不用连带跑几小时的股东数据。" />
            <Button Content="拉取分红" Command="{Binding FetchDividendCommand}" Width="80" Margin="4,0"
                    ToolTip="从新浪分红派息页(vISSUE_ShareBonus)抓每只股票【历年全部分红方案】,写入 Dividend 表:公告日期、送股/转增(每10股)、派息税前(每10股,元→每股股息=÷10)、进度(实施/预案/不分配)、股权登记日、除权除息日。&#10;&#10;库里原本没有任何分红明细——前复权把分红效果揉进了价格、反而看不出哪天除权派了多少,减法式前复权对高分红老股还会算出负价;做股息率因子、核对除权除息日都得靠这张表。&#10;&#10;逐只抓、全市场约5500只、每只1请求,较慢。分红一年一次为主、每次全量刷新。失败进\重新拉取失败股票\可重试。&#10;&#10;这一步也已并入\一键拉取定期数据\;这个独立按钮给单独刷新分红用,不用连带跑几小时的其它定期数据。前置:先\拉取全部\一次。" />
            <!-- 2026-08-15 补的按钮：股东数据以前只能靠"一键拉取定期数据"触发、且排在第3位，
                 前两步耗时很长，实际上等于没法单独刷新（修完解析bug后重抓就卡在这个坑上）。
                 财务报表/分红/行业分类早就各有独立按钮，这个漏了。 -->
            <Button Content="拉取股东数据" Command="{Binding FetchShareholderCommand}" Width="100" Margin="4,0"
                    ToolTip="逐只抓每只股票的【股东户数】+【十大股东】+【十大流通股东】全部历史，写入 ShareholderCount / TopShareholder 两张表，按股票代码整体覆盖。&#10;&#10;十大流通股东里的\香港中央结算有限公司\就是北向资金(陆股通)的名义持有人——外资持仓看这一行。&#10;&#10;逐只抓、全市场约5500只、每只2个页面，很慢(可能一两小时)。股东数据季度更新，跟财报同频跑一次即可。失败进\重新拉取失败股票\可重试。&#10;&#10;这一步也在\一键拉取定期数据\里(排第3位，前面还有行业分类和指数成分/权重)；这个独立按钮让你不用等前两步就能单独刷新股东数据。前置：先\拉取全部\一次。" />
            <Button Content="拉取行业分类" Command="{Binding FetchIndustryCommand}" Width="100" Margin="4,0"
                    ToolTip="抓全市场证监会行业分类，写入 StockIndustry 表。两级：【门类】(19类，如\制造业\)来自沪深两所官网、覆盖沪深全部；【大类】(84类，如\汽车制造业\)来自新浪、约覆盖58%。用的时候优先大类、缺失退回门类。&#10;&#10;用途：①因子法名单显示\板块\(原来用的静态映射表漏掉大量2021年后上市的次新股，名单里约28%显示\未分类\)；②FactorLab的行业中性化(原来用板块表只有44%覆盖、其余全挤在一个\未知\组里，中性IC一直不准)。&#10;&#10;行业极少变动，季度跟财报一起跑一次即可，整体覆盖写入、反复点无副作用。只要一两分钟。&#10;&#10;这一步也已并入\一键拉取定期数据\(放在最前面先跑完)。" />
        </StackPanel>

        <!-- 第4行 · 一次性回补：比第3行更低频，多数情况下装好之后就不用再点。
             （2026-08-15 从第3行拆出来——第3行加了"拉取股东数据"之后已经放不下 11 个控件。） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- 名为"一次性"，但**不能删**：它补的是融资余额/龙虎榜的逐日历史，而日常"拉取全部"
                 偶尔会漏（2026-08 实测融资余额从 7/30 起连续缺 12 个交易日），这时就靠它补回来。 -->
            <Button Content="一键补齐每日历史" Command="{Binding BackfillDailyCommand}" Width="130" Margin="0,0,4,0"
                    ToolTip="把每日数据(融资余额、龙虎榜)的历史从K线最早那天补到今天,逐交易日、跳过本地已有的日子。&#10;&#10;两种用途：①开发中新加了每日数据、之前没抓的补上历史；②【日常抓取漏了某几天时补回来】——\拉取全部\偶发失败会在这两张表里留下空洞，本地日线有那天、融资余额却没有，用这个按钮扫一遍就能补上。&#10;&#10;幂等、可反复点、跳过已有的日子。前置:先\拉取全部\一次(用K线最早日作补齐起点)。" />

            <!-- 按年份区间往回补历史（2026-07-29新增，同日从单年改为区间）——跟左边"一键补齐每日历史"
                 同类：一次性回补操作，不看第1/2行的输入（除了公告关键词），所以放在这一行而不是K线那行。 -->
            <TextBlock Text="年份：" Margin="16,0,0,0" VerticalAlignment="Center"
                       ToolTip="要往回补哪个年份区间的历史数据。只作用于右边的\拉取区间数据\" />
            <TextBox Text="{Binding FetchYearText, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     ToolTip="起始年份（4位，如 2016），默认去年。A股最早1990年，不能填晚于今年" />
            <TextBlock Text="~" VerticalAlignment="Center" />
            <TextBox Text="{Binding FetchYearEndText, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     ToolTip="结束年份（4位）。留空=从起始年一直补到现在；与起始年相同=只补那一年" />
            <CheckBox Content="覆盖重抓前复权" IsChecked="{Binding OverwriteQfq}" VerticalAlignment="Center" Margin="6,0,0,0"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                      ToolTip="勾上后，右边的\拉取区间数据\不再跳过本地已有的部分，而是把整段【前复权】按数据源当前基准重写一遍。&#10;&#10;用途：数据源的前复权是\原价−之后累计分红送配\，基准随抓取时点变化；而本地历史是分批入库、且默认不覆盖已有行，于是同一只股票不同时间段落在不同基准上，接缝处会出现假跳空（实测有股票虚增50%）。勾上跑一次可一次性抹平。&#10;&#10;代价：这一轮失去\已有就跳过\的优化，耗时与首次回补相当（十年约1.7小时）。&#10;&#10;平时不用勾：日常抓取会自动检测漂移并就地修正（见运行日志的\复权基准修正\）。后复权(day_hfq)不受漂移影响，回测那条线本来就是干净的。" />
            <Button Content="拉取区间数据" Command="{Binding FetchYearCommand}" Width="100" Margin="4,0"
                    ToolTip="把左边年份区间里【能取到历史】的数据一次补齐：个股/大盘指数/ETF日K(并自动重算周线月线)、【退市股名单与历史K线】、资金净流入、融资余额、龙虎榜、中标公告(用第1行的关键词)，最后按新数据重新合成板块指数。结束年留空=从起始年补到现在；起止相同=只补那一年。&#10;&#10;【只补缺的】每只标的先看本地最早的日K日期：已早于区间起点就整只跳过、不发请求；落在区间内就只补\区间起点→最早日前一天\这段缺口；更晚(或本地没有)就抓整个区间。融资/龙虎逐交易日抓、跳过本地已有的日子。可反复点、可随时\停止\，不会重复下载。&#10;&#10;【退市股】从沪深两所官网取终止上市名单(写入 DelistedStock 表，并以 type=delisted 记入标的清单，不会被日常轮询白抓)，再补终止日在区间起点之后那些股票的\区间起点→各自终止日\日K。这样回测池里既有当年在市的股票、也有后来退市的输家，消除幸存者偏差(否则回测收益被系统性高估，回测期越长越严重)。名单接口偶发失败只跳过这一段、不影响其它数据。&#10;&#10;【跳过】流通市值、板块行情与成分、指数成分与权重——这些接口只提供\当下快照\、没有往年的历史值，硬抓只会把今天的值当成那年的；股东户数/十大股东每次抓取本来就返回该股全部历史，跑一次\一键拉取定期数据\即已包含往年。&#10;&#10;【与\首次回看\的区别】回看年数只影响\本地从没抓过的标的\，调大它不会让已有标的的历史往前延长；要补更早的年份就用这个按钮填区间(如 2016~留空)。&#10;&#10;【与\拉取全部\的区别】这个按钮只向【后】补历史(补到各标的本地最早那天为止)，不会抓今天的新数据；日常增量仍然点\拉取全部\，两者互不冲突。&#10;&#10;⚠️ 新抓的往年K线用当前的前复权基准，与很久以前入库的较新K线可能存在复权基准差异。" />
        </StackPanel>

        <!-- 状态显示：运行中 + 已运行 + 本地数据覆盖/上次抓取，合并一行 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Binding IsBusy, StringFormat='运行中：{0}'}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ElapsedText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontWeight="Bold" />
            <TextBlock Text="{Binding DataStatusText}" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontWeight="Bold" />

            <!-- 自动重试的排定提示（2026-08-21新增，见 MainViewModel.ScheduleAutoRetry）：没排定时
                 AutoRetryText 是空串、这块自然不占地方，按钮灰着。 -->
            <TextBlock Text="{Binding AutoRetryText}" Margin="24,0,0,0" VerticalAlignment="Center"
                       Foreground="#B36B00" FontWeight="Bold" />
            <Button Content="取消自动重试" Command="{Binding CancelAutoRetryCommand}"
                    IsEnabled="{Binding HasAutoRetry}" Margin="8,0,0,0" Padding="8,0"
                    ToolTip="一轮抓取跑完后如果还有没补齐的数据，程序会自动排一次重试，时间取【跑完+1小时】和【当天21:00】里较晚的那个——盘后数据源是逐步更新的，等一会儿再抓才补得到。&#10;&#10;等待期间界面照常能用（不占用），到点如果正在跑别的会自动顺延10分钟再看。最多连做3轮；名单清零、或者某一轮之后待重试数量不再减少（剩下的多半是当天停牌、数据源确实没有的票）就会自动停下。&#10;&#10;点这个按钮取消本次排定；点【停止】也会一并取消。" />
        </StackPanel>

        <!-- 运行日志 -->
        <GroupBox Grid.Row="5" Header="运行日志">
            <TextBox local:LogText.Lines="{Binding LogLines}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     IsInactiveSelectionHighlightEnabled="True"
                     ToolTip="可用鼠标拖选、Ctrl+C 复制，Ctrl+A 全选" />
        </GroupBox>
    </Grid>
</Window>
