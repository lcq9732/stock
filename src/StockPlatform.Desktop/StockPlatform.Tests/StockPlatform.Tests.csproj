<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠ 版本必须是本地 global-packages 缓存里已有的：这台机器连不上 nuget.org（见仓库根的
         NuGet.config），换版本号会直接 NU1101 找不到包。缓存里现有 xunit 2.4.0/2.4.1/2.4.2/2.8.1。 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 调度逻辑 2026-09-02 从 Fetcher 挪进独立类库之后，这里就是普通的类库引用了。
         原先引用 Fetcher（自包含单文件 exe）要撞 NETSDK1151，只能跟着标 SelfContained。 -->
    <ProjectReference Include="..\..\StockPlatform.Scheduling\StockPlatform.Scheduling.csproj" />
    <!-- 2026-09-03：板块仓储改成"按来源替换"（东财/新浪两套并存）后加的引用。那段有 DELETE，
         写错会误删主库里另一个来源的板块，必须有测试兜着。Data 是普通类库，不涉及 NETSDK1151。 -->
    <ProjectReference Include="..\..\StockPlatform.Data\StockPlatform.Data.csproj" />
  </ItemGroup>

</Project>
