<Project Sdk="Microsoft.NET.Sdk">

  <!--
    分档资金流的「搬运」工具（2026-09-12）。

    为什么单独一个项目而不是 Fetcher 上的按钮：公司网关把 push2his 拦了之后，历史只能拿到
    另一条网络上抓，这是个一次性的搬运活。做成命令行小工具不碰产品代码，用完留着下次还能用。

    用法见 Program.cs 顶部，或 tools/README-moneyflow-transfer.md。
    刻意不加进 StockAnalyzer.sln：它不参与桌面端的发布，靠 `dotnet run` 加 project 参数单独跑。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StockPlatform.Tools.MoneyFlowTransfer</RootNamespace>
    <AssemblyName>MoneyFlowTransfer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用现成的 schema / Upsert / 排队判据，一行都不重写 -->
    <ProjectReference Include="..\..\src\StockPlatform.Data\StockPlatform.Data.csproj" />
  </ItemGroup>

</Project>
